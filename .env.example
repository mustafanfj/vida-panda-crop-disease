ANTHROPIC_API_KEY=   # Claude Sonnet 4.5, Claude Haiku 4.5
XAI_API_KEY=         # Grok-4.20-Fast
TOGETHER_API_KEY=    # Qwen-VL (Qwen3.5-9B), Gemma-3n-E4B
